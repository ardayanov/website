{
  "name": "dayanoff",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build-css": "sass styles.scss docs/styles.css --style compressed --no-source-map",
    "minify-html": "html-minifier-terser index.html -o docs/index.html --collapse-whitespace --remove-comments --minify-css true --minify-js true",
    "build": "npm run build-css && npm run minify-html"
  },
  "author": "Airat Dayanov",
  "devDependencies": {
    "html-minifier-terser": "^7.2.0",
    "sass": "^1.86.0"
  }
}
